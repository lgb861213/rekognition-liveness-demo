# AWS region — MUST match the backend / Rekognition endpoint region.
VITE_AWS_REGION=us-east-1

# Cognito Identity Pool ID used by FaceLivenessDetector to sign the
# StartFaceLivenessSession websocket request (unauthenticated identities enabled).
# Provisioned by the Terraform / CloudFormation stack.
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
