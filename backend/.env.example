# AWS region MUST match the Rekognition Face Liveness endpoint and the S3 bucket region.
AWS_REGION=us-east-1

# S3 bucket that stores the Face Liveness reference image and audit images.
# Must be in the SAME account and SAME region as the Rekognition endpoint.
LIVENESS_S3_BUCKET=my-rekognition-liveness-demo-us-east-1
LIVENESS_S3_PREFIX=liveness-audit/

# Rekognition collection used for 1:N face de-duplication (user vectors).
REKOGNITION_COLLECTION_ID=liveness-demo-collection

# Number of audit images to return (0-4).
AUDIT_IMAGES_LIMIT=2

# Liveness confidence threshold (0-100). Recommended >= 80.
LIVENESS_CONFIDENCE_THRESHOLD=80

# 1:N search similarity threshold (0-100). Recommended >= 90 for de-duplication.
USER_MATCH_THRESHOLD=90

# CORS origin of the frontend dev server.
FRONTEND_ORIGIN=http://localhost:3000

# OPTIONAL: cross-account de-dup. If set, backend assumes this role in the
# central "dedup" account before calling Rekognition collection APIs.
# CROSS_ACCOUNT_ROLE_ARN=arn:aws:iam::111122223333:role/RekognitionDedupRole
